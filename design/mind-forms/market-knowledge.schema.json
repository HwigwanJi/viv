{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keynes-investment-lab.local/schemas/mind-forms/v1/market-knowledge",
  "title": "시장 지식",
  "description": "공개 원문·주장·공개 정밀도·수집 시점·명시 범위를 보존하는 사용자 공유 라이브러리 양식. 실제 분류·승인은 서버 entry에 별도 보관한다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
    },
    "kind": {
      "const": "market-knowledge"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "user",
            "mcp-llm",
            "system-export",
            "market-provider"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
        },
        "uri": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https://"
        }
      },
      "required": [
        "type",
        "id",
        "uri"
      ],
      "additionalProperties": false
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "availableAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "profileId": {
          "const": null
        },
        "instrumentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "experimentId": {
          "const": null
        }
      },
      "required": [
        "profileId",
        "instrumentIds",
        "experimentId"
      ],
      "additionalProperties": false
    },
    "principleRefs": {
      "type": "array",
      "maxItems": 0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
        },
        "recordRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "contentHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 100
        },
        "classification": {
          "const": null
        }
      },
      "required": [
        "createdAt",
        "authorId",
        "recordRefs",
        "contentHashes",
        "classification"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "lineageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
        },
        "previousVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceType": {
          "enum": [
            "news",
            "macro-release",
            "investor-letter",
            "investor-disclosure",
            "research",
            "other"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "authors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48000
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
              }
            },
            "required": [
              "id",
              "text",
              "sourceRef"
            ],
            "additionalProperties": false
          }
        },
        "publication": {
          "type": "object",
          "properties": {
            "publishedAt": {
              "type": "string",
              "format": "date-time"
            },
            "precision": {
              "enum": [
                "instant",
                "day"
              ]
            },
            "sourcePublishedValue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "retrievedAt": {
              "type": "string",
              "format": "date-time"
            },
            "reportPeriodEnd": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "disclosureType": {
              "enum": [
                "none",
                "13f",
                "earnings",
                "letter",
                "other"
              ]
            },
            "sourceRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "publishedAt",
            "precision",
            "sourcePublishedValue",
            "timezone",
            "retrievedAt",
            "reportPeriodEnd",
            "disclosureType",
            "sourceRevision"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "global": {
              "type": "boolean"
            },
            "assetClasses": {
              "type": "array",
              "items": {
                "enum": [
                  "crypto",
                  "equity"
                ]
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "economies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "sectors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:@/-]{0,199}$"
              },
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "global",
            "assetClasses",
            "economies",
            "sectors"
          ],
          "additionalProperties": false
        },
        "validUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "lineageId",
        "previousVersionId",
        "sourceType",
        "publisher",
        "authors",
        "summary",
        "body",
        "claims",
        "publication",
        "coverage",
        "validUntil"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "source",
    "asOf",
    "availableAt",
    "scope",
    "principleRefs",
    "provenance",
    "data"
  ],
  "additionalProperties": false
}
