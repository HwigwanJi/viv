{
  "name": "keynes-investment-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && node --env-file-if-exists=.env scripts/preview.mjs --no-runners",
    "dev:css": "node scripts/build-styles.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && node scripts/check-mind-companion-ui.mjs && node scripts/check-design-tokens.mjs",
    "check:mind-companion": "node scripts/check-mind-companion-ui.mjs",
    "paper:watch": "node --env-file-if-exists=.env scripts/preview.mjs --paper-runner",
    "build": "npm run build:local",
    "build:local": "npm run check:contexts && npm run build:css && node scripts/build-vendor.mjs",
    "build:css": "node scripts/build-styles.mjs",
    "check:styles": "node scripts/check-design-tokens.mjs",
    "check:contexts": "node scripts/check-context-interactions.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-local.mjs"
  },
  "mindCompanionUI": {
    "contract": {
      "path": "design/mind-companion-ui-contract.json",
      "sha256": "e8660a3ed9453524a738514f0673aa1e01cf98bb47230755020d707a900beb25"
    },
    "checker": {
      "path": "scripts/check-mind-companion-ui.mjs",
      "sha256": "af0aff91361b4aa843922eef2c8f6f92db3d561a33e1d7e5c1ebfc488af19df3"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lightweight-charts": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "web-push": "3.6.7",
    "yaml": "2.9.1"
  }
}
