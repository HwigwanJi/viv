      {
        "id": "note-93ad1898-9615-4abc-b4b5-84fb90cb50ad",
        "title": "강한 기회에서 비중 확대",
        "text": "대화에서는 적은 손실과 드문 큰 수익을 함께 추구하고, 강한 상승 흐름에서 적극적으로 운용하는 클러치 기능을 요청했다. JEV의 보통·기회 집중 선택과 별도 목표 비중 정책으로 실험한다.",
        "kind": "hypothesis",
        "status": "proposed",
        "version": 1,
        "sourceTitle": "투자 아이디어 대화 · 요약",
        "sourceUrl": null,
