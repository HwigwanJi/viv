      {
        "id": "note-0db1a5ae-89e4-4e10-b359-8a6b379d801b",
        "title": "BTC 현물과 4시간봉",
        "text": "명세서는 BTC 현물 롱온리와 4시간봉 마감마다의 매수·보유·매도 출력을 정한다.",
        "kind": "observation",
        "status": "proposed",
        "version": 1,
        "sourceTitle": "BTC 결정모델 명세서 (Buy Hold Sell)",
        "sourceUrl": null,
        "sourceType": "attachment",
        "sourceLocator": "§1–2",
